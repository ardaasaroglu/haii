# Everything here is optional. The server boots with no env file at all, and on first start it
# creates server/.env with an ENCRYPTION_KEY in it. Copy what you need from here into server/.env.

# --- core ---
PORT=4820
APP_URL=http://localhost:4820
# Local mode has no login, so it only answers to localhost, a plain address, or the host named
# here. In local mode, anything in APP_URL other than localhost, 127.0.0.1, ::1 or a name ending in
# .localhost also needs ALLOW_LAN_DEV=1, or the server refuses to start. Use that only on a network
# you trust, and never put a public name here in local mode.
# 64 hex chars (32 bytes). Leave empty locally and one is generated and saved for you.
# Keep it: it decrypts every stored connector credential and cannot be rotated.
ENCRYPTION_KEY=

# --- Claude ---
# Your own Anthropic API key, from platform.claude.com. Reading a meeting needs it, and calls are
# billed to it. It stays in this file and is only ever sent to Anthropic.
ANTHROPIC_API_KEY=
# Reasoning effort for extraction and the weekly memory job: low or medium. Briefs always run at
# low, whatever this says.
LLM_EFFORT=medium

# --- spend limits (USD) ---
# Soft limits switch to a cheaper model for the rest of the day. Hard limits pause model jobs.
# The first two count every user together, the next two count each user on their own.
BUDGET_SOFT_USD=3
BUDGET_HARD_USD=8
USER_DAILY_SOFT_USD=0.75
USER_DAILY_HARD_USD=1.5
# Monthly limit for every user together. Model jobs pause until next month when it is reached.
MONTHLY_CAP_USD=60

# --- Google (optional): calendar, meeting notes, Gmail drafts, documents ---
# Create an OAuth client in Google Cloud. Redirect URI: APP_URL + /auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Slack (optional) ---
# Either paste a user token in Setup, or run your own Slack app. Slack only accepts https redirect
# URLs, so your own app needs APP_URL to be https. Redirect: APP_URL + /auth/slack/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# --- Jira and Confluence (optional) ---
# Connect them in Setup with your email, an API token and your site. Only the default Jira project
# is set here.
# The project key a new issue goes to when the card does not name one, for example ENG. It applies
# to every user on this instance, so on a shared instance it must exist on each user's Jira site.
JIRA_PROJECT=

# --- Telegram (optional): server alerts, plus briefs and nudges on a shared instance ---
TELEGRAM_BOT_TOKEN=
# A chat for server alerts: start, crash, job errors, budget.
TELEGRAM_ADMIN_CHAT_ID=
# Linking each user's own chat, so briefs and nudges reach them. Telegram delivers to a webhook,
# which needs a public https address, so this does not work on a local run. On a shared instance
# (DATABASE_URL set), set both, then register APP_URL + /telegram/webhook with Telegram's
# setWebhook, using this secret.
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=

# --- running it for several people (unused locally) ---
# Setting DATABASE_URL switches from the embedded database to managed Postgres and turns on
# Google sign-in. ENCRYPTION_KEY must then be set by you.
DATABASE_URL=
# Comma-separated, case-insensitive.
ALLOWED_EMAILS=
ADMIN_EMAILS=
# A shared secret for admin-only API calls, sent in the x-admin-token header.
ADMIN_TOKEN=

# --- misc ---
# Phone testing on home wifi: set HOST=0.0.0.0 and ALLOW_LAN_DEV=1 together. Without the second the
# server refuses to boot, because that is an unauthenticated admin API on your network. Never on a
# server.
# HOST=0.0.0.0
ALLOW_LAN_DEV=
# The local user's id. Leave it alone unless you know why.
DEV_AUTOLOGIN=owner
LOG_LEVEL=info
# Where the embedded database lives, relative to server/.
DATA_DIR=.data
